# Environment
NODE_ENV=development

# CORS
ALLOWED_ORIGIN=http://localhost:5173

# Database (local PostgreSQL)
DATABASE_URL=postgresql://localhost:5432/farm_roundtable_dev

# Session
SESSION_SECRET=dev-secret-change-in-production

# OpenRouter AI (REQUIRED)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Perplexity (optional — enables web search for Research Analyst)
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# Stripe (optional in dev mode — DEV_MODE=true bypasses)
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_PRICE_ID_PRO=price_xxx
STRIPE_PRICE_ID_ENTERPRISE=price_yyy
STRIPE_WEBHOOK_SECRET=whsec_...

# OpenWeatherMap (optional — enables weather-aware experts in Phase 3)
# NOTE: the app uses the One Call 3.0 endpoint (/data/3.0/onecall), so the key
# must be a 32-hex-char OWM key that is subscribed/enabled for One Call 3.0
# (free tier: 1,000 calls/day, card required at signup). Legacy 2.5-only keys
# will 401; the app then reports weather as unavailable with reason "auth".
OWM_API_KEY=your-openweathermap-api-key-here

# Local AI (optional — for self-hosted models via ollama/LM Studio/llama.cpp)
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_API_KEY=optional, most local servers don't need it

# BYOK Encryption (REQUIRED — 32-byte key for AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=your-32-byte-base64-or-hex-key-here
