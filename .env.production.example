# ──────────────────────────────────────────────────────────────────────────────
# FarmFriend Roundtable PRO — Production Environment
# Copy this file to .env.production and fill in your values.
# Run:  cp .env.production.example .env.production
# ──────────────────────────────────────────────────────────────────────────────

# ─── Core ─────────────────────────────────────────────────────────────────────
# [REQUIRED] Must be "production"
NODE_ENV=production

# [REQUIRED] Public URL of your instance (used for CORS + Stripe webhooks)
# Example: https://farm.example.com  or  http://192.168.1.50:5001
ALLOWED_ORIGIN=https://your-domain.com

# [REQUIRED] Server port (inside container). Usually leave as 5001.
PORT=5001

# ─── Database ─────────────────────────────────────────────────────────────────
# [REQUIRED] These are used by the db service AND to build DATABASE_URL.
POSTGRES_DB=farm_roundtable_prod
POSTGRES_USER=farmuser
POSTGRES_PASSWORD=change-me-strong-password-here

# [REQUIRED] Full connection string (used by the app container).
# When using docker-compose, the hostname is "db".
DATABASE_URL=postgresql://farmuser:change-me-strong-password-here@db:5432/farm_roundtable_prod

# ─── Session Security ─────────────────────────────────────────────────────────
# [REQUIRED] Minimum 32-character random string.
# Generate with:  openssl rand -hex 32
SESSION_SECRET=[REQUIRED] generate-with-openssl-rand-hex-32

# ─── AI Providers ─────────────────────────────────────────────────────────────
# [REQUIRED] OpenRouter API key — powers the AI roundtable.
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=[REQUIRED] your-openrouter-api-key-here

# [OPTIONAL] Perplexity API key — enables web search for the Research Analyst.
# Get one at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# [OPTIONAL] Local AI base URL — for self-hosted models (Ollama, LM Studio, etc.)
# When Ollama is enabled via docker-compose profile, use: http://ollama:11434/v1
LOCAL_AI_BASE_URL=http://localhost:11434/v1

# [OPTIONAL] Local AI API key — most local servers don't require one.
LOCAL_AI_API_KEY=optional

# ─── Ollama (Local LLM) ───────────────────────────────────────────────────────
# [OPTIONAL] Set to "true" to enable the Ollama service in docker-compose.
# You must start compose with:  docker compose --profile ollama up -d
OLLAMA_ENABLED=false

# ─── Payments (Stripe) ────────────────────────────────────────────────────────
# [OPTIONAL] Required only if you want to charge subscriptions.
# In dev mode these are bypassed; in production they are enforced.
STRIPE_SECRET_KEY=sk_live_...
VITE_STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Weather ──────────────────────────────────────────────────────────────────
# [OPTIONAL] OpenWeatherMap API key — enables weather-aware farm advice.
# Get one at: https://home.openweathermap.org/api_keys
OWM_API_KEY=your-openweathermap-api-key-here

# ─── Farm-Specific Configuration ──────────────────────────────────────────────
# [OPTIONAL] Default GPS coordinates for weather lookups (lat,lon).
# Example:  41.8781,-87.6298  (Chicago)
FARM_LOCATION_LAT=41.8781
FARM_LOCATION_LON=-87.6298

# [OPTIONAL] Preferred local AI model when Ollama is enabled.
# Common choices: llama3, llama3.1, mistral, phi3
OLLAMA_MODEL=llama3
